# Copy existing Meetha service settings. Never commit real credentials.
API_ENV=
API_LOGO_FILENAME=
BACKEND_URL=
BILLING_MEETHA_APP_ID=
BILLING_SERVICE_BASE_URL=
COOKIE_EXPIRATION_HOURS=24
DATA_ROOT=
EMAIL_FROM=
EMAIL_SERVER=
EVENTS_DIR=
FIRST_REGISTER_CREDIT_AMOUNT=
FIRST_REGISTER_CREDIT_IS_ACTIVE=
FRONTEND_URL=
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_SECRET=replace-with-existing-jwt-secret
LLM_SERVER=
NODE_ENV=development
PER_MINUTE_RATE=
PG_MIDTRANS_CLIENT_KEY=
PG_MIDTRANS_IS_ACTIVE=
PG_MIDTRANS_IS_PRODUCTION=
PG_MIDTRANS_SERVER_KEY=
PORT=3000
REDIS_SERVER=127.0.0.1:6379
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USERNAME=
SQL_DATABASE_NAME=meetha
SQL_DIALECT=postgres
SQL_HOST=127.0.0.1
SQL_IDLE=10000
SQL_MAX_POOL=10
SQL_MIN_POOL=0
SQL_PASSWORD=
SQL_PORT=5432
SQL_USERNAME=
SSO_SERVICE_BASE_URL=
STATIC_DIR=
STT_SERVER=http://stt:8080
SUMMARY_DIR=
UPLOAD_DIR=
USER_SERVICE_BASE_URL=

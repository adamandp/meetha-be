ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_S2S_ACCOUNT_ID=
ZOOM_S2S_API_KEY=
ZOOM_S2S_API_SECRET=

# Optional DATABASE_URL overrides SQL_* connection settings.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/meetha
# For legacy encrypted SQL_PASSWORD, provide the existing AES key.
SQL_PASSWORD_ENCRYPTION_KEY=
DATA_ROOT=../../meetha
RUNTIME_ENABLED=true
WS_RELAY_ENABLED=true
WS_RELAY_PORT=8080
LOG_LEVEL=info
